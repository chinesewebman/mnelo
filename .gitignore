*.bak
*.bak-*
*.bak.*
*.old
.*.swp

# Logs / runtime
*.log
*.pid
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# [8/8 P1 followup] mnelo runtime artifacts (索引 / 备份 / log)
# search_index.zv/ = zvec 索引 (mcp_server 跑时锁住)
# usearch.index* = usearch 索引 (测试 fixture / 早期部署)
# snapshots/ = db + 索引快照 (dr-backup 产物, 30 天滚动)
# .sync-backups/ = sync-backup 工具产物
# logs/ = hygiene / hygiene dry-run json 输出
search_index.zv/
usearch.index*
# [8/14 fix] 8/12 split 后索引路径绑定 db_path.stem (e.g. memory.db → memory.usearch.index),
# 旧 gitignore 没覆盖前缀, runtime files leak 到 git status
*.usearch.index
*.usearch.index.verified.json
*.usearch.index.corrupt-*
usearch.index*.verified.json
snapshots/
.sync-backups/
logs/

# Secrets / config override (用 config.toml.example 作模板)
.env
.env.local
*.local.toml
.env/
# [7/19 P0-2 fix] mnelo auth token 文件不进 git
mnelo_auth_token
*.mnelo_token
auth-token
# venv
venv/

# Test artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.cover
coverage.xml

# local venv (Claude Code dev env)
.venv/

# local gh CLI state (created when HOME pointed here)
.local/
